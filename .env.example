# Dodo IS API (OAuth 2.0, device flow)
DODO_CLIENT_ID=
DODO_CLIENT_SECRET=
DODO_COUNTRY=

# Первая пара для засева хранилища токена; дальше пара живёт в таблице
# dodo_oauth_token и обновляется сама (см. token_store.py)
DODO_ACCESS_TOKEN=
DODO_REFRESH_TOKEN=

# Postgres (Supabase): прямое подключение, ETL ходит мимо RLS
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=
SUPABASE_USER=
SUPABASE_PASSWORD=
USE_CLOUD_DB=true

# Справочник точек: путь к файлу вида yakutsk_units.example.json
YAKUTSK_UNITS_JSON=

# Прочие источники
DODODESK_BASE_URL=
DODOPIZZA_USERNAME=
DODOPIZZA_PASSWORD=
BITRIX_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
